msgstr "Alle Suchen"

#: views/admin/tab-stats.php:142
#: views/admin/tab-stats.php:143
msgid "Filter by search phrase"
msgstr "Nach Suchbegriff filtern"

#: views/admin/tab-stats.php:145
msgid "Filter by mode"
msgstr "Nach Modus filtern"

#: views/admin/tab-stats.php:147
